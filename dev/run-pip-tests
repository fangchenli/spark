# Script to test pip installation of PySpark.
# Tests both sdist install and editable install modes.

set -e
shopt -s nullglob

FWDIR="$(cd "$(dirname "$0")"/..; pwd)"
cd "$FWDIR"

# Clean up disk space on GitHub Actions (see SPARK-44557)
if [[ -n "${GITHUB_ACTIONS}" ]]; then
  git clean -d -f -x -e assembly -e python/coverage.xml -e target/test-reports/
fi

# Check for required tools
if ! hash pip 2>/dev/null; then
  echo "Missing pip, skipping pip installability tests."
  exit 0
fi

if ! hash python3 2>/dev/null; then
  echo "Python3 not installed, skipping pip installability tests."
  exit 0
fi

# Determine virtualenv tool (prefer venv, then virtualenv, then conda)
if python3 -c "import venv" 2>/dev/null && [[ -z "$USE_CONDA" ]]; then
  VENV_TOOL="venv"
elif hash virtualenv 2>/dev/null && [[ -z "$USE_CONDA" ]]; then
  VENV_TOOL="virtualenv"
elif hash conda 2>/dev/null; then
  VENV_TOOL="conda"
  USE_CONDA=1
else
  echo "Missing venv, virtualenv & conda, skipping pip installability tests."
  exit 0
fi

# Exclude user site-packages to prevent side effects
export PYTHONNOUSERSITE=1

# Create temp directory for virtual environments
VIRTUALENV_BASE=$(mktemp -d)
trap "echo 'Cleaning up $VIRTUALENV_BASE'; rm -rf '$VIRTUALENV_BASE'" EXIT

# Get PySpark version
PYSPARK_VERSION=$(python3 -c "exec(open('python/pyspark/version.py').read());print(__version__)")
PYSPARK_DIST="$FWDIR/dist/pyspark-$PYSPARK_VERSION.tar.gz"

# Build sdist in a temporary venv to avoid system package issues
echo "Building PySpark sdist..."
rm -rf python/pyspark.egg-info dist/pyspark-*.tar.gz 2>/dev/null || true
BUILD_VENV="$VIRTUALENV_BASE/build"
python3 -m venv "$BUILD_VENV"
source "$BUILD_VENV/bin/activate"
pip install --quiet --upgrade pip build
python3 -m build --sdist
deactivate

# Verify sdist was created
if [[ ! -f "$PYSPARK_DIST" ]]; then
  echo "Failed to create sdist at $PYSPARK_DIST"
  exit 1
fi

PIP_OPTIONS="--upgrade --no-cache-dir --force-reinstall"

# Test function to run sanity checks
run_sanity_checks() {
  echo "Running sanity checks..."
  # Test with spark-submit
  spark-submit "$FWDIR/dev/pip-sanity-check.py"
  # Test with direct python import
  python3 "$FWDIR/dev/pip-sanity-check.py"
  # Test context.py
  python3 "$FWDIR/python/pyspark/core/context.py"
}

# Test function for a single install mode
test_install() {
  local install_mode=$1
  local venv_path="$VIRTUALENV_BASE/$install_mode"

  echo ""
  echo "=============================================="
  echo "Testing: $install_mode install"
  echo "=============================================="

  # Create and activate virtual environment
  rm -rf "$venv_path"
  if [[ "$VENV_TOOL" == "conda" ]]; then
    conda create -y -p "$venv_path" python=3.10 numpy pandas pip setuptools
    source activate "$venv_path" || conda activate "$venv_path"
  elif [[ "$VENV_TOOL" == "venv" ]]; then
    python3 -m venv "$venv_path"
    source "$venv_path/bin/activate"
    pip install --quiet --upgrade pip wheel numpy
  else
    virtualenv --python=python3 "$venv_path"
    source "$venv_path/bin/activate"
    pip install --quiet --upgrade pip wheel numpy
  fi

  # Install PySpark
  cd "$FWDIR"
  if [[ "$install_mode" == "sdist" ]]; then
    pip install $PIP_OPTIONS "$PYSPARK_DIST"
  else
    pip install $PIP_OPTIONS -e .
  fi

  # Run tests from a neutral directory
  cd /
  run_sanity_checks
  cd "$FWDIR"

  # Deactivate
  if [[ "$VENV_TOOL" == "conda" ]]; then
    source deactivate 2>/dev/null || conda deactivate
  else
    deactivate
  fi
}

# Run tests for both install modes
test_install "sdist"
test_install "editable"

echo ""
echo "All pip installation tests passed!"
exit 0
